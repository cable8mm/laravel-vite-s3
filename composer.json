{
    "name": "cable8mm/laravel-vite-s3",
    "description": "Sync the Vite build output to an S3 (or any Flysystem) disk with one artisan command.",
    "keywords": [
        "laravel",
        "vite",
        "s3",
        "cdn"
    ],
    "license": "MIT",
    "homepage": "https://github.com/cable8mm/laravel-vite-s3",
    "support": {
        "issues": "https://github.com/cable8mm/laravel-vite-s3/issues",
        "source": "https://github.com/cable8mm/laravel-vite-s3"
    },
    "authors": [
        {
            "name": "Samgu Lee",
            "email": "cable8mm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cable8mm\\LaravelViteS3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cable8mm\\LaravelViteS3\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/phpunit tests"
        ],
        "lint": [
            "./vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cable8mm\\LaravelViteS3\\ViteS3ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
